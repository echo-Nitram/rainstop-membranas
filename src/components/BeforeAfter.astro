---
import WhatsAppButton from "./WhatsAppButton.astro";
import { WA_MESSAGES, WORK_SAMPLES } from "../consts";
---

<section id="trabajos" class="bg-brand-cream-alt py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-yellow mb-2" data-reveal>Trabajos realizados</p>
    <h2 class="text-3xl sm:text-4xl max-w-xl mb-4" data-reveal>Antes y después</h2>
    <p class="text-neutral-600 max-w-2xl mb-10" data-reveal>
      Así quedan los techos que impermeabilizamos: mismo techo, antes de
      empezar y con la membrana ya terminada.
    </p>

    <div class="snap-row">
      {WORK_SAMPLES.map((job, i) => (
        <div
          class="tilt-card w-[300px] sm:w-[420px] shrink-0 rounded-2xl overflow-hidden border border-neutral-200 bg-white shadow-sm"
          data-reveal={i % 2 === 0 ? "up" : "scale"}
          style={`transition-delay: ${i * 90}ms`}
        >
          <div class="grid grid-cols-2 gap-px bg-neutral-200">
            <div class="relative aspect-3/4 overflow-hidden bg-neutral-100">
              <img src={job.before} alt={`${job.title} — antes`} class="h-full w-full object-cover" loading="lazy" />
              <span class="absolute top-2 left-2 rounded-full bg-black/70 text-white text-[10px] font-bold uppercase tracking-wide px-2.5 py-1">Antes</span>
            </div>
            <div class="relative aspect-3/4 overflow-hidden bg-neutral-100">
              <img src={job.after} alt={`${job.title} — después`} class="h-full w-full object-cover" loading="lazy" />
              <span class="absolute top-2 left-2 rounded-full bg-brand-yellow text-brand-black text-[10px] font-bold uppercase tracking-wide px-2.5 py-1">Después</span>
            </div>
          </div>
          <p class="px-4 py-3 text-sm font-semibold text-neutral-700">{job.title}</p>
        </div>
      ))}
    </div>

    <div class="mt-10" data-reveal>
      <WhatsAppButton message={WA_MESSAGES.instagram} label="Quiero un techo así" variant="outline-dark" />
    </div>
  </div>
</section>

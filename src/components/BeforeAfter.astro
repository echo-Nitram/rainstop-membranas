---
import WhatsAppButton from "./WhatsAppButton.astro";
import { WA_MESSAGES, WORK_SAMPLES } from "../consts";
---

<section id="trabajos" class="bg-brand-cream-alt py-12 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-gold mb-2" data-reveal>Trabajos realizados</p>
    <h2 class="text-3xl sm:text-4xl max-w-xl mb-4" data-reveal>Antes y después</h2>
    <p class="text-neutral-600 max-w-2xl mb-8 sm:mb-10" data-reveal>
      Mismo techo, antes de empezar y con la membrana ya terminada.{" "}
      <strong class="text-neutral-800">Deslizá la flecha amarilla</strong> para comparar.
    </p>

    <div class="snap-row">
      {WORK_SAMPLES.map((job, i) => (
        <div
          class="w-[300px] sm:w-[420px] shrink-0 rounded-2xl overflow-hidden border border-neutral-200 bg-white shadow-sm"
          data-reveal={i % 2 === 0 ? "up" : "scale"}
          style={`transition-delay: ${i * 90}ms`}
        >
          <div class="ba relative aspect-3/4 overflow-hidden bg-neutral-100 select-none">
            <img src={job.before} alt={`${job.title} — antes`} class="absolute inset-0 h-full w-full object-cover" loading="lazy" draggable="false" />
            <img src={job.after} alt={`${job.title} — después`} class="ba-after absolute inset-0 h-full w-full object-cover" loading="lazy" draggable="false" />
            <span class="absolute top-2 left-2 rounded-full bg-black/70 text-white text-[10px] font-bold uppercase tracking-wide px-2.5 py-1">Antes</span>
            <span class="absolute top-2 right-2 rounded-full bg-brand-yellow text-brand-black text-[10px] font-bold uppercase tracking-wide px-2.5 py-1">Después</span>
            <div
              class="ba-handle absolute inset-y-0 w-11 -translate-x-1/2 flex items-center justify-center"
              role="slider"
              tabindex="0"
              aria-label={`Comparar antes y después: ${job.title}`}
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="50"
            >
              <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-white shadow"></span>
              <span class="relative grid h-11 w-11 place-items-center rounded-full bg-brand-yellow text-brand-black text-lg font-black shadow-lg" aria-hidden="true">↔</span>
            </div>
          </div>
          <p class="px-4 py-3 text-sm font-semibold text-neutral-700">{job.title}</p>
        </div>
      ))}
    </div>

    <div class="mt-8 sm:mt-10" data-reveal>
      <WhatsAppButton message={WA_MESSAGES.instagram} label="Quiero un techo así" variant="outline-dark" />
    </div>
  </div>
</section>

<script>
  // Comparador: se arrastra solo con la flecha (el resto de la foto sigue
  // sirviendo para deslizar el carrusel). También con las flechas del teclado.
  // Sin JS queda partido al 50% con la flecha de adorno.
  try {
    document.querySelectorAll<HTMLElement>(".ba").forEach((ba) => {
      const handle = ba.querySelector<HTMLElement>(".ba-handle");
      if (!handle) return;
      let pos = 50;
      const set = (p: number) => {
        pos = Math.max(2, Math.min(98, p));
        ba.style.setProperty("--pos", pos + "%");
        handle.setAttribute("aria-valuenow", String(Math.round(pos)));
      };
      let dragging = false;
      handle.addEventListener("pointerdown", (e) => {
        dragging = true;
        handle.setPointerCapture(e.pointerId);
      });
      handle.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const r = ba.getBoundingClientRect();
        set(((e.clientX - r.left) / r.width) * 100);
      });
      ["pointerup", "pointercancel"].forEach((ev) => handle.addEventListener(ev, () => (dragging = false)));
      handle.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") { set(pos - 5); e.preventDefault(); }
        if (e.key === "ArrowRight") { set(pos + 5); e.preventDefault(); }
      });
    });
  } catch {
    // Si falla, queda la comparación estática al 50%.
  }
</script>

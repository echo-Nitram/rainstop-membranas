---
import { PRICE_PER_M2, SERVICES, waLink, WA_MESSAGES } from "../consts";

// Reusamos waLink para no duplicar el número de WhatsApp acá — el script del
// cliente solo reconstruye la parte "?text=" a partir de esta misma base.
const baseHref = waLink(WA_MESSAGES.pricing).split("?")[0];
---

<section id="presupuesto" class="bg-brand-cream-alt py-16 sm:py-20">
  <div class="mx-auto max-w-xl px-5 sm:px-8 text-center">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-yellow mb-2" data-reveal>Calculá tu presupuesto</p>
    <h2 class="text-3xl sm:text-4xl mb-4" data-reveal>¿Cuánto cuesta impermeabilizar tu techo?</h2>
    <p class="text-neutral-600 mb-10" data-reveal>
      Contanos los m² aproximados y te mostramos una referencia al instante.
      El presupuesto exacto y sin costo te lo confirmamos por WhatsApp.
    </p>

    <div class="tilt-card rounded-2xl border border-neutral-200 bg-white p-6 sm:p-8 text-left" data-reveal="scale">
      <label for="calc-m2" class="block text-sm font-bold text-neutral-700 mb-2">
        ¿Cuántos m² tiene tu techo, aprox.?
      </label>
      <input
        id="calc-m2"
        type="number"
        inputmode="numeric"
        min="1"
        step="1"
        placeholder="Ej: 60"
        class="w-full rounded-xl border border-neutral-300 px-4 py-3 text-lg font-semibold mb-5 outline-none focus:border-brand-yellow focus:ring-2 focus:ring-brand-yellow/30"
      />

      <label for="calc-membrana" class="block text-sm font-bold text-neutral-700 mb-2">
        Membrana (opcional)
      </label>
      <select
        id="calc-membrana"
        class="w-full rounded-xl border border-neutral-300 px-4 py-3 mb-6 font-medium text-neutral-700 outline-none focus:border-brand-yellow"
      >
        <option value="">No estoy seguro / recomendame la mejor opción</option>
        {SERVICES.map((s) => (
          <option value={s.name}>{s.name}</option>
        ))}
      </select>

      <div id="calc-result" class="hidden rounded-xl bg-brand-yellow-bg border border-brand-yellow/40 px-5 py-4 mb-6">
        <p class="text-sm text-neutral-700 mb-1">Estimado de referencia</p>
        <p class="font-display text-3xl sm:text-4xl text-neutral-900">
          desde $<span id="calc-price">0</span>
        </p>
        <p class="text-xs text-neutral-600 mt-1">
          El precio final depende del estado del techo — te lo confirmamos sin costo.
        </p>
      </div>

      <a
        id="calc-cta"
        href={waLink(WA_MESSAGES.pricing)}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary w-full"
        data-wa-cta="Calculadora de presupuesto"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H12l-5 1 1-5v-.35A8.5 8.5 0 1 1 21 11.5Z"></path>
        </svg>
        <span>Pedir presupuesto exacto por WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<script define:vars={{ pricePerM2: PRICE_PER_M2, baseMessage: WA_MESSAGES.pricing, baseHref }}>
  try {
    const m2Input = document.getElementById("calc-m2");
    const membranaSelect = document.getElementById("calc-membrana");
    const resultBox = document.getElementById("calc-result");
    const priceSpan = document.getElementById("calc-price");
    const ctaLink = document.getElementById("calc-cta");

    function update() {
      const m2 = parseFloat(m2Input.value);
      const membrana = membranaSelect.value;
      const hasM2 = m2 && m2 > 0;

      if (hasM2) {
        const price = Math.round(m2 * pricePerM2);
        priceSpan.textContent = price.toLocaleString("es-UY");
        resultBox.classList.remove("hidden");
      } else {
        resultBox.classList.add("hidden");
      }

      let msg = baseMessage.replace("___", hasM2 ? `${m2} m²` : "(a confirmar)");
      if (membrana) msg += ` Me interesa la ${membrana}.`;
      ctaLink.href = `${baseHref}?text=${encodeURIComponent(msg)}`;
    }

    m2Input.addEventListener("input", update);
    membranaSelect.addEventListener("change", update);
  } catch {
    // Si el script falla, el botón sigue mandando al WhatsApp con el mensaje genérico.
  }
</script>

---
import { waLink, WA_MESSAGES } from "../consts";
const href = waLink(WA_MESSAGES.floating);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribinos por WhatsApp"
  class="wa-float fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-brand-yellow text-brand-black font-extrabold px-5 py-3.5 shadow-xl hover:brightness-105 active:translate-y-0 transition"
>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H12l-5 1 1-5v-.35A8.5 8.5 0 1 1 21 11.5Z"></path>
  </svg>
  <span class="hidden sm:inline">Escribinos</span>
</a>

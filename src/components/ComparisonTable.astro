---
import { SERVICES } from "../consts";
---

<div class="relative -mx-5 sm:mx-0 mb-14">
  <div class="overflow-x-auto" id="comparison-scroll" data-reveal>
    <table class="w-full min-w-[640px] border-separate border-spacing-0 text-sm">
    <thead>
      <tr>
        <th class="text-left text-neutral-400 font-semibold uppercase text-xs tracking-wide pb-3 pl-1">
          &nbsp;
        </th>
        {SERVICES.map((s) => (
          <th class="text-left pb-3 px-4">
            <span class="block text-brand-yellow text-xs font-bold uppercase tracking-wide mb-1">{s.tagline}</span>
            <span class="block text-lg font-bold text-neutral-100">{s.name}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="py-4 pl-1 pr-4 text-neutral-400 font-semibold align-top">Punto fuerte</td>
        {SERVICES.map((s) => (
          <td class="py-4 px-4 border-t border-neutral-800 align-top text-neutral-200">{s.bullets[0]}</td>
        ))}
      </tr>
      <tr>
        <td class="py-4 pl-1 pr-4 text-neutral-400 font-semibold align-top">Terminación</td>
        {SERVICES.map((s) => (
          <td class="py-4 px-4 border-t border-neutral-800 align-top text-neutral-200">{s.bullets[s.bullets.length - 1]}</td>
        ))}
      </tr>
      <tr>
        <td class="py-4 pl-1 pr-4 text-neutral-400 font-semibold align-top">Ideal para</td>
        {SERVICES.map((s) => (
          <td class="py-4 px-4 border-t border-b border-neutral-800 align-top text-neutral-300">{s.description}</td>
        ))}
      </tr>
    </tbody>
  </table>
  </div>
  <div class="comparison-fade sm:hidden" aria-hidden="true"></div>
</div>

<script>
  // Pista de que la tabla tiene más columnas hacia la derecha en mobile
  // (donde min-width fuerza scroll horizontal): un fade que desaparece
  // una vez que el usuario llega al final del scroll.
  try {
    const scrollEl = document.getElementById("comparison-scroll");
    const fade = document.querySelector(".comparison-fade");
    if (scrollEl && fade) {
      const update = () => {
        const atEnd = scrollEl.scrollLeft + scrollEl.clientWidth >= scrollEl.scrollWidth - 4;
        fade.classList.toggle("is-hidden", atEnd);
      };
      scrollEl.addEventListener("scroll", update, { passive: true });
      update();
    }
  } catch {
    // Si falla, la tabla sigue siendo scrolleable igual, solo sin la pista visual.
  }
</script>

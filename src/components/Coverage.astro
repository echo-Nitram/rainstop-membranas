---
import WhatsAppButton from "./WhatsAppButton.astro";
import { WA_MESSAGES, COVERAGE_AREAS } from "../consts";

// Coordenadas reales (aprox., a nivel de localidad) de cada zona de
// COVERAGE_AREAS, para el mapa real de abajo. Si se agrega o saca una zona
// en COVERAGE_AREAS y no tiene coordenadas acá, simplemente no se dibuja.
const ZONE_COORDS: Record<string, { lat: number; lng: number; radius: number; primary?: boolean }> = {
  montevideo: { lat: -34.9011, lng: -56.1645, radius: 7000, primary: true },
  "las-piedras": { lat: -34.7167, lng: -56.2167, radius: 3000 },
  canelones: { lat: -34.5385, lng: -56.2760, radius: 3000 },
  pando: { lat: -34.7167, lng: -55.9500, radius: 3000 },
  "ciudad-de-la-costa": { lat: -34.7833, lng: -55.9500, radius: 4000 },
};
const zones = COVERAGE_AREAS.map((area) => ({ ...area, ...ZONE_COORDS[area.slug] })).filter(
  (z) => typeof z.lat === "number"
);
---

<section id="cobertura" class="bg-white py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 text-center">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-yellow mb-2" data-reveal>Dónde trabajamos</p>
    <h2 class="text-3xl sm:text-4xl mb-4" data-reveal>Zona de cobertura en Montevideo y alrededores</h2>
    <p class="text-neutral-600 max-w-xl mx-auto mb-8" data-reveal>
      Si no ves tu localidad en la lista, escribinos igual — es probable que
      también la cubramos.
      <!-- TODO: confirmar con el cliente la zona de cobertura exacta -->
    </p>

    <div class="flex flex-wrap justify-center gap-3 mb-10" data-reveal>
      {COVERAGE_AREAS.map((area) => (
        <a
          href={`/zonas/${area.slug}/`}
          class="rounded-full bg-brand-cream-alt border border-neutral-200 px-5 py-2 text-sm font-semibold text-neutral-700 hover:bg-brand-yellow hover:border-brand-yellow transition-colors duration-200"
        >
          {area.name}
        </a>
      ))}
    </div>

    <!--
      Mapa real (Leaflet + OpenStreetMap, sin API key ni costo) con círculos
      resaltando las 5 zonas de COVERAGE_AREAS. Reemplaza tanto el iframe de
      Google Maps genérico original como el gráfico ilustrativo posterior.
    -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <div
      id="coverage-map"
      class="mb-10 h-[340px] sm:h-[420px] overflow-hidden rounded-2xl border border-neutral-200 shadow-sm bg-brand-cream-alt"
      data-reveal
      data-zones={JSON.stringify(zones.map((z) => ({ name: z.name, lat: z.lat, lng: z.lng, radius: z.radius, primary: !!z.primary })))}
    >
    </div>

    <div data-reveal>
      <WhatsAppButton message={WA_MESSAGES.pricing} label="Consultar mi zona" variant="outline-dark" />
    </div>
  </div>
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="" is:inline></script>
<script is:inline>
  // Mapa real de la zona de cobertura (Leaflet + tiles de OpenStreetMap,
  // gratis y sin API key). Si algo falla o el script de Leaflet no carga
  // (por ejemplo sin conexión a unpkg.com), la sección de cobertura sigue
  // funcionando igual: solo no se ve el mapa.
  try {
    const container = document.getElementById("coverage-map");
    if (container && window.L) {
      const zones = JSON.parse(container.dataset.zones || "[]");
      if (zones.length) {
        const map = L.map(container, { scrollWheelZoom: false });
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 18,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        }).addTo(map);

        const bounds = L.latLngBounds(zones.map((z) => [z.lat, z.lng]));
        zones.forEach((z) => {
          L.circle([z.lat, z.lng], {
            radius: z.radius,
            color: "#141310",
            weight: 1.5,
            fillColor: "#ffc400",
            fillOpacity: z.primary ? 0.35 : 0.25,
          })
            .addTo(map)
            .bindTooltip(z.name, { permanent: true, direction: "center", className: "coverage-map-label" });
        });
        map.fitBounds(bounds, { padding: [24, 24] });
      }
    }
  } catch {
    // Si falla, la sección sigue funcionando: solo sin el mapa.
  }
</script>

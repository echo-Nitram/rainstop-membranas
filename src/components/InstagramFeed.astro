---
import { INSTAGRAM_URL, INSTAGRAM_HANDLE } from "../consts";

// TODO: sumar más capturas reales de posteos acá a medida que se publiquen.
const placeholders = [1, 2, 3, 4, 5];
---

<section class="bg-brand-black text-brand-cream py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-yellow mb-2">Redes sociales</p>
    <h2 class="text-3xl sm:text-4xl mb-4">Seguinos en Instagram</h2>
    <p class="text-neutral-400 max-w-2xl mb-10">
      Mostramos trabajos, tips y promociones estacionales en {INSTAGRAM_HANDLE}.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="col-span-2 row-span-2 sm:row-span-1 aspect-square rounded-xl overflow-hidden border border-neutral-800"
      >
        <img
          src="/images/post-ejemplo-instagram.webp"
          alt="Publicación de Instagram de RAINSTOP: técnico aplicando membrana asfáltica en un techo"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </a>

      {placeholders.map((i) => (
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="aspect-square rounded-xl border border-neutral-800 bg-brand-graphite flex items-center justify-center text-neutral-600 hover:text-brand-yellow transition-colors"
          aria-label="Ver más en Instagram"
        >
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17" cy="7" r="1"></circle>
          </svg>
        </a>
      ))}
    </div>

    <a
      href={INSTAGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-outline mt-8"
    >
      Ver más en Instagram →
    </a>
  </div>
</section>

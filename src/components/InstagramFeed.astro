---
import { INSTAGRAM_URL, INSTAGRAM_HANDLE, GALLERY_IMAGES } from "../consts";

// La imagen destacada (más grande) es una foto real de un trabajo, no el
// gráfico publicitario — una foto real transmite más confianza en el lugar
// con más peso visual. El resto, incluido ese gráfico, va en las tiles chicas.
const heroSrc = "/images/gallery/gallery-2.webp";
const hero = GALLERY_IMAGES.find((img) => img.src === heroSrc) ?? GALLERY_IMAGES[0];
const rest = GALLERY_IMAGES.filter((img) => img !== hero);
---

<section class="bg-brand-black text-brand-cream py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <p class="text-xs font-bold tracking-widest uppercase text-brand-yellow mb-2" data-reveal>Redes sociales</p>
    <h2 class="text-3xl sm:text-4xl mb-4" data-reveal>Seguinos en Instagram</h2>
    <p class="text-neutral-400 max-w-2xl mb-10" data-reveal>
      Mostramos trabajos, tips y promociones estacionales en {INSTAGRAM_HANDLE}.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
      <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="shine-card col-span-2 row-span-2 sm:row-span-1 aspect-square rounded-xl overflow-hidden border border-neutral-800 group hover:border-brand-yellow/60 transition-colors duration-300"
        data-reveal="scale"
      >
        <img
          src={hero.src}
          alt={hero.alt}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        />
      </a>

      {rest.map((img, i) => (
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="shine-card aspect-square rounded-xl overflow-hidden border border-neutral-800 group hover:border-brand-yellow/60 transition-colors duration-300"
          data-reveal="scale"
          style={`transition-delay: ${i * 60}ms`}
        >
          <img
            src={img.src}
            alt={img.alt}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
            loading="lazy"
          />
        </a>
      ))}
    </div>

    <a
      href={INSTAGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-outline mt-8"
    >
      Ver más en Instagram →
    </a>
  </div>
</section>

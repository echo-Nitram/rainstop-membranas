---
import WhatsAppButton from "./WhatsAppButton.astro";
import { WA_MESSAGES } from "../consts";

const consequences = [
  "Manchas de humedad y hongos en cielorrasos y paredes",
  "Daño estructural progresivo en el techo",
  "Reparaciones de emergencia mucho más caras que la prevención",
  "Pérdida de aislación térmica en tu casa",
];
---

<section class="bg-brand-cream py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-5 sm:px-8 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
    <div data-reveal>
      <p class="text-xs font-bold tracking-widest uppercase text-brand-yellow mb-2">
        No esperes a la próxima lluvia
      </p>
      <h2 class="text-3xl sm:text-4xl mb-5">
        ¿Qué pasa si no impermeabilizás tu techo a tiempo?
      </h2>
      <p class="text-neutral-600 text-lg mb-6 max-w-lg">
        Una filtración nunca se queda del mismo tamaño. Cuanto más se posterga, más
        se complica y encarece la solución.
      </p>
      <WhatsAppButton
        message={WA_MESSAGES.heroPrimary}
        label="Quiero evitar esto en mi techo"
        variant="outline-dark"
      />
    </div>

    <ul class="grid gap-4">
      {consequences.map((c, i) => (
        <li class="card-hover flex items-start gap-3 bg-white border border-neutral-200 rounded-2xl p-4" data-reveal style={`transition-delay: ${i * 80}ms`}>
          <span class="mt-0.5 shrink-0 flex h-7 w-7 items-center justify-center rounded-full bg-brand-yellow-bg text-brand-yellow font-bold">
            !
          </span>
          <span class="text-neutral-700 font-medium">{c}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

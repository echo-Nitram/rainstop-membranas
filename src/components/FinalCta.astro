---
import WhatsAppButton from "./WhatsAppButton.astro";
import { WA_MESSAGES, TEL_LINK } from "../consts";

// Copy estacional: cambiar este título según la época del año (ver brief de CRO).
// Otoño/invierno -> "Antes de que lleguen las lluvias, protegé tu techo."
// Primavera/verano -> "Aprovechá el buen tiempo para renovar tu techo."
const seasonalTitle = "Antes de que lleguen las lluvias, protegé tu techo";
---

<section class="relative overflow-hidden bg-brand-black text-brand-cream py-20 sm:py-28 text-center">
  <svg class="pointer-events-none absolute -left-16 -bottom-16 w-[420px] opacity-[0.06]" data-parallax="0.12" viewBox="0 0 400 260" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true">
    <path d="M20 180 L200 40 L380 180" />
    <path d="M60 200 L200 90 L340 200" />
  </svg>

  <div class="relative mx-auto max-w-2xl px-5 sm:px-8">
    <h2 class="text-3xl sm:text-4xl md:text-5xl mb-5" data-reveal>{seasonalTitle}</h2>
    <p class="text-neutral-300 text-lg mb-9" data-reveal style="transition-delay: 90ms">
      Agendá una visita sin costo y llevate tu techo listo para enfrentar la
      lluvia, el sol y los cambios de temperatura.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 mb-8" data-reveal style="transition-delay: 180ms">
      <WhatsAppButton message={WA_MESSAGES.finalCta} label="Agendar por WhatsApp" id="final-wa-cta" class="text-base px-8 py-4" />
      <a href={TEL_LINK} class="btn btn-outline text-brand-cream text-base px-8 py-4">
        📞 Llamar ahora
      </a>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm font-bold text-neutral-300" data-reveal style="transition-delay: 240ms">
      <span class="flex items-center gap-1.5"><span class="text-brand-yellow">✓</span> Garantía de 10 años</span>
      <span class="flex items-center gap-1.5"><span class="text-brand-yellow">✓</span> Sin costo ni compromiso</span>
      <span class="flex items-center gap-1.5"><span class="text-brand-yellow">✓</span> Respuesta el mismo día</span>
    </div>
  </div>
</section>

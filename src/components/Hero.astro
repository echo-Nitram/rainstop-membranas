---
import WhatsAppButton from "./WhatsAppButton.astro";
import { WA_MESSAGES, TEL_LINK } from "../consts";

// Props opcionales para poder reusar este mismo Hero en las páginas de zona
// (src/pages/zonas/[localidad].astro) sin duplicar el markup.
interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  waMessage?: string;
}

const {
  badge = "☔ Impermeabilizaciones a domicilio en Montevideo",
  title = "Impermeabilización de techos con membrana asfáltica en Montevideo",
  subtitle,
  waMessage = WA_MESSAGES.heroPrimary,
} = Astro.props;
---

<section id="inicio" class="relative overflow-hidden bg-brand-black text-brand-cream">
  <!-- textura decorativa: techo a dos aguas, trazo original, solo estética -->
  <svg class="pointer-events-none absolute -right-24 -top-20 w-[520px] opacity-[0.07]" data-parallax="0.15" viewBox="0 0 400 260" fill="none" stroke="currentColor" stroke-width="6" aria-hidden="true">
    <path d="M20 180 L200 40 L380 180" />
    <path d="M60 200 L200 90 L340 200" />
    <path d="M120 220 L120 160 L160 160 L160 220" />
  </svg>

  <div class="relative mx-auto max-w-6xl px-5 sm:px-8 pt-16 pb-20 sm:pt-24 sm:pb-28">
    <span class="hero-in inline-flex items-center gap-2 rounded-full bg-brand-yellow-bg/10 border border-brand-yellow/40 text-brand-yellow text-xs font-bold tracking-widest uppercase px-4 py-1.5 mb-6">
      {badge}
    </span>

    <h1 class="hero-in text-4xl sm:text-5xl md:text-6xl max-w-3xl" style="animation-delay: 90ms">
      {title}
    </h1>

    <p class="hero-in mt-6 max-w-2xl text-lg sm:text-xl text-neutral-300 font-medium" style="animation-delay: 180ms">
      {subtitle ?? (
        <>
          Materiales, mano de obra y terminación profesional en aluminio incluidos —
          con <span class="text-brand-yellow font-bold">garantía de 10 años</span> y
          presupuesto sin costo por WhatsApp.
        </>
      )}
    </p>

    <div class="hero-in mt-10 flex flex-wrap items-center gap-4" style="animation-delay: 270ms">
      <WhatsAppButton message={waMessage} label="Pedí tu presupuesto gratis" />
      <a href={TEL_LINK} class="btn btn-outline text-brand-cream">
        📞 Llamar ahora
      </a>
    </div>

    <p class="hero-in mt-6 text-sm text-neutral-400" style="animation-delay: 340ms">
      Presupuesto sin costo ni compromiso · Te respondemos por WhatsApp en el día
    </p>
  </div>
</section>
